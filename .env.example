# Copy to .env and fill in. Both values are public testnet settings, not secrets.

# 6-decimal test USDt on Sepolia that the Candide paymaster accepts. Mint it at
# https://dashboard.candide.dev/faucet and copy the token contract address shown there.
EXPO_PUBLIC_SEPOLIA_TEST_TOKEN_ADDRESS=

# Optional: Sepolia JSON-RPC endpoint (default: publicnode).
EXPO_PUBLIC_SEPOLIA_RPC=

# 1 = demo build: separate database, never reads the SMS inbox, synthetic data only.
EXPO_PUBLIC_DEMO_MODE=0

# "device" (in-app WDK) or "laptop" (scripts/wallet/cli.ts signs; testnet stopgap).
EXPO_PUBLIC_WALLET_SIGNER=device
# Laptop signer only: public addresses from `npm run wallet -- addresses`.
EXPO_PUBLIC_SPENDING_ADDRESS=
EXPO_PUBLIC_SAVINGS_ADDRESS=
